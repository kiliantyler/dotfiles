if status is-interactive

    fish_add_path ~/.local/bin
    fish_add_path ~/.bin

    # Theme - ./themes/Dracula Official.theme
    fish_config theme choose "Dracula Official"

    # Remove greeting
    set -g fish_greeting

    # Path
    set -gx PATH $PATH $HOME/.krew/bin # Krew plugins

    # Programs
    type -q atuin; and atuin init fish --disable-up-arrow | source

    # Simplified prompt for VS Code / Cursor integrated terminals
    if test "$TERM_PROGRAM" = "vscode" -o "$TERM_PROGRAM" = "cursor"
      function fish_prompt
        echo -n "> "
      end
    else
      function starship_transient_rprompt_func
        starship module time
      end

      function starship_transient_prompt_func
        starship module character
      end

    # Claude Code: always skip permissions prompt
    alias claude 'command claude --dangerously-skip-permissions'

    # API keys (baked in by chezmoi from 1Password SDK)
    set -gx GEMINI_API_KEY "{{ onepasswordRead "op://Chezmoi/GEMINI_API_KEY/password" }}"
    set -gx NANOBANANA_GEMINI_API_KEY "{{ onepasswordRead "op://Chezmoi/GEMINI_API_KEY/password" }}"

    # Completions
    atuin gen-completions --shell fish | source
    kubectl completion fish | source
    talosctl completion fish | source
    helm completion fish | source

    function starship_transient_rprompt_func
      starship module time
    end
end


function reload
    exec fish
end
{{- if .isWork }}
set -gx AWS_DEFAULT_REGION us-east-1
{{- end }}
