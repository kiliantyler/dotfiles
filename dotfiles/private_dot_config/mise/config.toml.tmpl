# chezmoi:template:left-delimiter="[[" right-delimiter="]]"
[settings]
experimental = true
yes = true
status = { missing_tools = "always", show_env = false, show_tools = false }
trusted_config_paths = ["{{ get_env(name='HOME') }}/git/"]
disable_hints = ["python_multi"]
idiomatic_version_file_enable_tools = ["node"]

[tools]
1password-cli = "latest"
act = "latest"
age = "latest"
bun = "latest"
chezmoi = "latest"
cilium-cli = "latest"
direnv = "latest"
dotenvx = "latest"
"aqua:editorconfig-checker/editorconfig-checker" = "latest"
flux2 = "latest"
github-cli = "latest"
go = "latest"
goreleaser = "latest"
helm = "latest"
helmfile = "latest"
jq = "latest"
kubectl = "latest"
kubectx = "latest"
kustomize = "latest"
node = "[[ if .isWork ]]22[[ else ]]24[[ end ]]"
pnpm = "12.16.1"
python = "latest"
rust = { version = "latest", install_env = { ASDF_RUST_PROFILE = "minimal" }, postinstall = 'RUSTUP_HOME="$MISE_TOOL_INSTALL_PATH" CARGO_HOME="$MISE_TOOL_INSTALL_PATH" rustup component add rustfmt clippy' }
shellcheck = "latest"
sops = "latest"
talhelper = "latest"
talosctl = "latest"
task = "latest"
terraform = "latest"
terraform-docs = "latest"
terragrunt = "latest"
usage = "latest"
uv = "latest"
yamlfmt = "latest"
yarn = "[[ if .isWork ]]1.22.22[[ else ]]latest[[ end ]]"
yq = "latest"
"npm:@google/gemini-cli" = "latest"
[[- if .isWork ]]
awscli = "latest"
k9s = "latest"
krew = "latest"
kubecolor = "latest"
ktlint = "latest"
powershell = "7.6.6"
ruff = "latest"
shfmt = "latest"
[[- end ]]
