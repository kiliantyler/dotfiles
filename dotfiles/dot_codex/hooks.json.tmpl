{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/t3-pr-watch.sh\"",
            "timeout": 30
          }
        ]
      }{{ template "hindsight-hook" (dict "home" .chezmoi.homeDir "agent" "codex" "hook" "sessionstart-hook" "timeout" 30) }}
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/t3-pr-watch.sh\"",
            "timeout": 30
          }
        ]
      }{{ template "hindsight-hook" (dict "home" .chezmoi.homeDir "agent" "codex" "hook" "hook" "timeout" 30) }}
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/t3-pr-watch.sh\"",
            "timeout": 30
          }
        ]
      }{{ template "hindsight-hook" (dict "home" .chezmoi.homeDir "agent" "codex" "hook" "stop-hook" "timeout" 60) }}
    ]
  }
}
