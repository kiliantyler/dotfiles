#!/bin/bash
# Installs anything in the Brewfile that is missing. Re-runs when the Brewfile changes.
# Brewfile hash: {{ include "private_dot_config/homebrew/Brewfile" | sha256sum }}
set -euo pipefail
if ! command -v brew >/dev/null; then
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi
brew bundle install --file "{{ .chezmoi.homeDir }}/.config/homebrew/Brewfile" --no-upgrade
