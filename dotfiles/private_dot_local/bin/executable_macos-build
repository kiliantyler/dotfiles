#!/usr/bin/env python3
"""Run a Git working-copy snapshot in the dedicated macOS build VM."""
import argparse
from contextlib import ExitStack, contextmanager
import fcntl
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time

BASE_VM = 't3-macos-build'
VM = f'{BASE_VM}-run-{os.getpid()}'
JOB_CPUS = 4
JOB_MEMORY_MIB = 8192
HOST_MEMORY_GIB = 12
HOST_CPUS = 4
VM_OVERHEAD_GIB = 2
MAX_MACOS_VMS = 2


def run(*args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


def guest(*args, **kwargs):
    return run('tart', 'exec', VM, *args, **kwargs)


def reserve_space(path, required=0):
    available = shutil.disk_usage(path).free
    if available - required < 20 * 1024**3:
        raise RuntimeError(f'Host has {available / 1024**3:.1f} GiB free; keep 20 GiB plus {required / 1024**3:.1f} GiB for this operation')


def start_postgres(job):
    prefix = guest('/bin/zsh', '-lc', 'brew --prefix postgresql@18', capture_output=True, text=True).stdout.strip()
    binary = prefix + '/bin/'
    data = job + '/postgres'
    locale = ['/usr/bin/env', 'LC_ALL=en_US.UTF-8']
    guest(*locale, binary + 'initdb', '-D', data, '-U', 'build', '-A', 'trust', '-E', 'UTF8', stdout=subprocess.DEVNULL)
    options = shlex.join(['-h', '127.0.0.1', '-p', '5432', '-k', job])
    try:
        guest(*locale, binary + 'pg_ctl', '-D', data, '-l', job + '/postgres.log', '-o', options, '-w', 'start', stdout=subprocess.DEVNULL)
    except subprocess.CalledProcessError:
        subprocess.run(['tart', 'exec', VM, '/usr/bin/tail', '-n', '50', job + '/postgres.log'])
        raise
    return 'postgres://build@127.0.0.1:5432/postgres'


def reap_pending(state):
    pending = state / 'pending-vm'
    if not pending.exists():
        return
    previous = pending.read_text().strip()
    if not re.fullmatch(re.escape(BASE_VM) + r'-run-[0-9]+', previous):
        raise RuntimeError('Invalid pending VM cleanup record')
    vms = json.loads(run('tart', 'list', '--source', 'local', '--format', 'json', capture_output=True, text=True).stdout)
    orphan = next((v for v in vms if v['Name'] == previous), None)
    if orphan and orphan['Running']:
        raise RuntimeError(f'{previous} is still running; inspect its owner before cleanup')
    if orphan:
        run('tart', 'delete', previous)
    pending.unlink()


@contextmanager
def build_slot(state, root, wait):
    last_message = None
    with (state / 'admission').open('a+') as admission:
        try:
            fcntl.flock(admission, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            admission.seek(0)
            message = f'An earlier build is waiting for admission: PID {admission.readline().strip() or "unknown"}'
            if not wait:
                raise RuntimeError(message)
            print(f'Waiting: {message}', file=sys.stderr, flush=True)
            fcntl.flock(admission, fcntl.LOCK_EX)
        admission.seek(0); admission.truncate()
        admission.write(f'{os.getpid()}\n{root}\n'); admission.flush()
        while True:
            with ExitStack() as locks:
                # Shared for jobs, exclusive for legacy runners and prepared-image maintenance.
                legacy = locks.enter_context((state / 'lease').open('a+'))
                try:
                    fcntl.flock(legacy, fcntl.LOCK_SH | fcntl.LOCK_NB)
                except BlockingIOError:
                    legacy.seek(0)
                    message = f'Legacy build or image maintenance owns PID {legacy.readline().strip() or "unknown"}; see {state / "lease"}'
                else:
                    if (state / 'pending-job').exists():
                        raise RuntimeError('The prepared base has deferred legacy cleanup; resolve it before cloning')
                    reap_pending(state)
                    memory, cpus, pressure = map(int, run('sysctl', '-n', 'hw.memsize', 'hw.logicalcpu', 'kern.memorystatus_vm_pressure_level', capture_output=True, text=True).stdout.split())
                    capacity = min(MAX_MACOS_VMS, (memory // 1024**3 - HOST_MEMORY_GIB) // (JOB_MEMORY_MIB // 1024 + VM_OVERHEAD_GIB), (cpus - HOST_CPUS) // JOB_CPUS)
                    if capacity < 1:
                        raise RuntimeError('Host cannot reserve an 8 GiB/4 CPU build VM while retaining host resources')
                    selected = None
                    message = f'All {capacity} macOS build slots are occupied; inspect {state}/slot-*/lease'
                    if pressure != 1:
                        message = f'Host memory pressure is {pressure}; builds require normal memory pressure'
                    else:
                        for index in range(capacity):
                            slot = state / f'slot-{index}'
                            slot.mkdir(exist_ok=True)
                            owner = (slot / 'lease').open('a+')
                            try:
                                fcntl.flock(owner, fcntl.LOCK_EX | fcntl.LOCK_NB)
                            except BlockingIOError:
                                owner.close()
                                continue
                            locks.enter_context(owner)
                            reap_pending(slot)
                            owner.seek(0); owner.truncate()
                            owner.write(f'{os.getpid()}\n{root}\n'); owner.flush()
                            selected = slot
                            break
                    if selected is not None:
                        fcntl.flock(admission, fcntl.LOCK_UN)
                        yield selected
                        return
            if not wait:
                raise RuntimeError(message)
            if message != last_message:
                print(f'Waiting: {message}', file=sys.stderr, flush=True)
                last_message = message
            time.sleep(1)

@contextmanager
def build_vm(state):
    pending = state / 'pending-vm'
    vms = json.loads(run('tart', 'list', '--source', 'local', '--format', 'json', capture_output=True, text=True).stdout)
    base = next((v for v in vms if v['Name'] == BASE_VM), None)
    if not base:
        raise RuntimeError(f'Provision {BASE_VM} before running macos-build')
    if base['Running']:
        raise RuntimeError(f'{BASE_VM} is already running outside this build lease')
    reserve_space(state)
    created = False
    stopped = True
    try:
        run('tart', 'clone', BASE_VM, VM, env={**os.environ, 'TART_NO_AUTO_PRUNE': '1'})
        created = True
        pending.write_text(VM)
        run('tart', 'set', VM, '--cpu', str(JOB_CPUS), '--memory', str(JOB_MEMORY_MIB))
        tart_home = Path(os.environ.get('TART_HOME', str(Path.home() / '.tart')))
        run('tmutil', 'addexclusion', str(tart_home / 'vms' / VM))
        with (state / 'vm.log').open('w') as log:
            process = subprocess.Popen(['tart', 'run', '--no-graphics', '--no-audio', '--no-clipboard', '--no-usb-accessories', VM], stdout=log, stderr=log, start_new_session=True)
            stopped = False
            try:
                deadline = time.monotonic() + 180
                while True:
                    if process.poll() is not None:
                        raise RuntimeError(f'VM startup failed; see {state / "vm.log"}')
                    try:
                        if guest('/usr/bin/uname', '-s', capture_output=True, text=True, timeout=10).stdout.strip() == 'Darwin':
                            break
                    except (subprocess.CalledProcessError, subprocess.TimeoutExpired):
                        pass
                    if time.monotonic() >= deadline:
                        raise RuntimeError('The macOS guest did not become ready')
                    time.sleep(1)
                yield
            finally:
                try:
                    if process.poll() is None:
                        run('tart', 'stop', VM, timeout=60)
                        process.wait(timeout=30)
                except (subprocess.SubprocessError, OSError) as error:
                    print(f'macos-build: job VM shutdown deferred: {error}', file=sys.stderr)
                stopped = process.poll() is not None
    finally:
        if created and stopped:
            try:
                run('tart', 'delete', VM)
                pending.unlink(missing_ok=True)
            except (subprocess.SubprocessError, OSError) as error:
                print(f'macos-build: job VM cleanup deferred: {error}', file=sys.stderr)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--artifact', action='append', default=[], help='Export a repository-relative, Git-ignored output path')
    parser.add_argument('--wait', action='store_true', help='Wait for a build slot and normal host memory pressure')
    parser.add_argument('--postgres', action='store_true', help='Start a private guest PostgreSQL 18 cluster and set TEST_DATABASE_URL')
    parser.add_argument('command', nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = args.command[1:] if args.command[:1] == ['--'] else args.command
    if not command:
        parser.error('provide a command after --')
    root = Path(run('git', 'rev-parse', '--show-toplevel', capture_output=True, text=True).stdout.strip()).resolve()
    relative = Path.cwd().resolve().relative_to(root)
    entries = run('git', '-C', str(root), 'ls-files', '--stage', '-z', capture_output=True).stdout.split(b'\0')
    if any(entry.startswith(b'160000 ') for entry in entries):
        raise RuntimeError('Submodule working copies are not supported by this snapshot runner')
    for artifact in args.artifact:
        path = Path(artifact)
        if path.is_absolute() or '..' in path.parts or not path.parts:
            parser.error('artifacts must be repository-relative paths')
        run('git', '-C', str(root), 'check-ignore', '-q', '--', artifact)
    state = Path.home() / '.local/state/macos-build'
    state.mkdir(parents=True, exist_ok=True, mode=0o700)
    with build_slot(state, root, args.wait) as slot:
        with build_vm(slot):
            job = guest('/usr/bin/mktemp', '-d', '/tmp/macos-build.XXXXXX', capture_output=True, text=True).stdout.strip()
            with tempfile.TemporaryDirectory(prefix='macos-build-') as temporary:
                temporary = Path(temporary)
                run('git', '-C', str(root), 'bundle', 'create', str(temporary / 'repo.bundle'), 'HEAD')
                files = run('git', '-C', str(root), 'ls-files', '--cached', '--others', '--exclude-standard', '-z', capture_output=True).stdout.split(b'\0')
                with tarfile.open(temporary / 'source.tar', 'w') as archive:
                    for name in filter(None, files):
                        path = root / os.fsdecode(name)
                        if os.path.lexists(path):
                            archive.add(path, arcname=os.fsdecode(name), recursive=False)
                with tarfile.open(temporary / 'input.tar', 'w') as archive:
                    for name in ['repo.bundle', 'source.tar']:
                        archive.add(temporary / name, arcname=name)
                with (temporary / 'input.tar').open('rb') as archive:
                    run('tart', 'exec', '-i', VM, '/usr/bin/tar', '-xf', '-', '-C', job, stdin=archive)
            q = shlex.quote
            guest('/bin/sh', '-c', f'git clone -q --no-checkout {q(job + "/repo.bundle")} {q(job + "/repo")} && cd {q(job + "/repo")} && git reset --mixed -q HEAD && tar -xf ../source.tar')
            directory = str(Path(job) / 'repo' / relative)
            environment = ['/usr/bin/env', 'TEST_DATABASE_URL=' + start_postgres(job)] if args.postgres else []
            with subprocess.Popen(['tart', 'exec', VM, *environment, '/bin/zsh', '-lc', f'cd {q(directory)} && exec {shlex.join(command)}']) as execution:
                while True:
                    try:
                        code = execution.wait(timeout=1)
                        break
                    except subprocess.TimeoutExpired:
                        try:
                            reserve_space(state)
                        except RuntimeError:
                            execution.terminate()
                            execution.wait(timeout=10)
                            raise
            for artifact in args.artifact:
                try:
                    with tempfile.TemporaryFile() as archive:
                        with subprocess.Popen(['tart', 'exec', VM, '/usr/bin/tar', '-cf', '-', '-C', job + '/repo', '--', artifact], stdout=subprocess.PIPE) as transfer:
                            while chunk := transfer.stdout.read(8 * 1024**2):
                                try:
                                    reserve_space(root, len(chunk))
                                except RuntimeError:
                                    transfer.terminate()
                                    transfer.wait(timeout=10)
                                    raise
                                archive.write(chunk)
                            if status := transfer.wait():
                                raise subprocess.CalledProcessError(status, transfer.args)
                        archive.seek(0)
                        with tarfile.open(fileobj=archive) as outputs:
                            reserve_space(root, sum(member.size for member in outputs.getmembers()))
                            outputs.extractall(root, filter='data')
                except (RuntimeError, subprocess.SubprocessError, tarfile.TarError, OSError) as error:
                    print(f'macos-build: could not export {artifact}: {error}', file=sys.stderr)
                    code = code or 1
            return code


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (RuntimeError, subprocess.SubprocessError, OSError) as error:
        print(f'macos-build: {error}', file=sys.stderr)
        sys.exit(1)
