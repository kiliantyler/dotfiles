# Minimal chezmoi config. Everything not set here is a chezmoi default.
encryption: age
age:
  identity: ~/.config/chezmoi/key.txt
  recipient: "age16mykf4nyrlvwmlgpgvpmd97mc0npydcjq30wc4jvsapcheu8lvjsh8u4g8"
  suffix: .age
diff:
  exclude: [scripts]
edit:
  command: code
  args: ["--wait"]
status:
  pathStyle: relative
template:
  options: [missingkey=error]
data:
  # Work laptops are named L<digits>-<name>
  isWork: {{ regexMatch "^L\\d+-" .chezmoi.hostname }}
