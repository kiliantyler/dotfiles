{{ if .isWork -}}
{{ include ".work/claude-settings.json.age" | decrypt }}
{{- else -}}
{
  "includeCoAuthoredBy": false,
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "i-have-adhd@i-have-adhd": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "switchModelsOnFlag": false,
  "env": {
    "CLAUDE_CODE_SHELL": "/opt/homebrew/bin/bash"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/t3-pr-watch.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/t3-pr-watch.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/t3-pr-watch.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
{{ end -}}
