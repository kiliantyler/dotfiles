{{ if .isWork -}}
{{ include ".work/claude-settings.json.age" | decrypt }}
{{- else -}}
{
  "includeCoAuthoredBy": false,
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "i-have-adhd@i-have-adhd": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "switchModelsOnFlag": false,
  "env": {
    "CLAUDE_CODE_SHELL": "/opt/homebrew/bin/bash"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$T3CODE_THREAD_ID\" ] || echo 'T3 PR watch check: a T3 PR watch can drop silently, a dropped watch never wakes you, and a summary saying a PR is watched is not proof. Before anything else this turn, load mcp__t3-code__list_thread_pull_requests and mcp__t3-code__watch_pull_request with ToolSearch, call list_thread_pull_requests, and for every open PR you still wait on that shows watching: false call watch_pull_request with until merged. Then read the checks on each such head yourself instead of treating silence as pending.'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/t3-pr-watch-stop.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
{{ end -}}
